{"name":"discord-lyrics-status","version":"1.0.0","description":"Real-time Spotify lyrics displayed as your Discord custom status","type":"module","main":"electron/main.cjs","author":"Rafaela Ayumi","license":"MIT","repository":{"type":"git","url":"https://github.com/rafaelacatzz/discord-status-spotify.git"},"scripts":{"start":"node src/index.js","dev":"node --watch src/index.js","build":"node build.mjs","generate-icons":"node scripts/generate-icons.js","build:installer":"node scripts/generate-icons.js && node build.mjs electron","build:electron":"node build.mjs electron","refresh-icon-cache":"powershell -ExecutionPolicy Bypass -File scripts/refresh-icon-cache.ps1","kill-app":"powershell -ExecutionPolicy Bypass -File scripts/kill-app.ps1","build:daemon":"dotnet publish smtc-daemon/SmtcDaemon.csproj -c Release && node -e \"require('fs').copyFileSync('smtc-daemon/bin/Release/net8.0-windows10.0.19041.0/win-x64/publish/SmtcDaemon.exe', 'smtc-daemon/SmtcDaemon.exe')\"","electron":"npm run build:daemon && node build.mjs bundle && electron .","postinstall":"node -e \"try{require('child_process').execSync('npm run build:daemon',{stdio:'inherit'})}catch{console.log('⚠️  C# daemon not built. Run: npm run build:daemon (requires .NET SDK 8.0+)')}\""},"dependencies":{},"devDependencies":{"dotenv":"^16.3.1","electron":"^33.0.0","electron-builder":"^25.0.0","esbuild":"^0.25.0","express":"^4.18.2","ws":"^8.18.0"}}
